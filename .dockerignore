# Allowlist: everything is excluded unless re-included below, so local secrets, data and VCS metadata never reach a layer.
*

!go.mod
!go.sum
!cmd/
!internal/
!pkg/
!web/

web/node_modules/
web/tools/
web/test-results/
web/playwright-report/
internal/ui/dist/assets/
internal/ui/dist/index.html

**/*_test.go
**/testdata/
**/.DS_Store
**/*.creds
**/*.nk
**/keys.enc
**/*.db
**/*.db-wal
**/*.db-shm
